# ---- Google Service Account (Sheets + Drive) ----
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escapes literal; the app converts them to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-drive-root-folder-id

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
SESSION_SECRET=change-me-too
# Refresh token lifetime (days) for the mobile app's biometric unlock.
REFRESH_TOKEN_DAYS=30

# ---- App ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ---- Defaults (can be overridden later in Settings sheet) ----
STUDENT_ID_PREFIX=LIB
RECEIPT_PREFIX=RCPT
DEFAULT_CURRENCY=INR

# ---- Backups (section 45) ----
# Set to "true" only if this process stays running continuously (in-process
# cron). If deploying to Render, prefer the separate Cron Job in render.yaml
# instead (it runs `node scripts/runBackup.js` on its own schedule and isn't
# affected by the web service sleeping/restarting) and leave this "false".
BACKUP_ENABLED=false
BACKUP_CRON=0 2 * * *

# ---- Sheets read cache ----
# How long (ms) a sheet's rows are cached before being re-fetched. Lower =
# fresher data, more Sheets API calls. 0 disables caching.
SHEETS_READ_CACHE_TTL_MS=4000

# ---- Push notifications (mobile app payment-due reminders) ----
# A Firebase project's own service account (NOT the Google Sheets one
# above) — Project Settings > Service Accounts > Generate new private key.
# Same "host can sleep" caveat as backups: if deploying to Render, prefer
# a separate Cron Job running `node scripts/runPaymentReminders.js` and
# leave PUSH_ENABLED=false here.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
PUSH_REMINDER_CRON=0 9 * * *
